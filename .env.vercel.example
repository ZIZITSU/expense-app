# Copy to .env.vercel.local for the import script, and add the same values
# in Vercel > Project Settings > Environment Variables. Never commit secrets.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token
APP_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
